{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indigenous-australia.local/schema.json",
  "title": "Indigenous Australia content pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "knowledge", "groups", "stories", "places", "people", "timeline", "further_reading"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "version", "created", "map_caveat", "deceased_persons_warning_default"],
      "properties": {
        "pack": { "type": "string", "minLength": 1 },
        "version": { "type": "number" },
        "created": { "type": "string", "minLength": 1 },
        "map_caveat": { "type": "string", "minLength": 1 },
        "deceased_persons_warning_default": { "type": "string", "minLength": 1 },
        "deceased_warning_note": {
          "type": "string",
          "description": "Source note only. The public catalog withholds it."
        }
      }
    },
    "knowledge": { "type": "array", "items": { "$ref": "#/$defs/knowledge" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "stories": { "type": "array", "items": { "$ref": "#/$defs/story" } },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "people": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "timeline": { "type": "array", "items": { "$ref": "#/$defs/timeline" } },
    "further_reading": { "type": "array", "items": { "$ref": "#/$defs/reading" } }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "label": { "type": "string", "pattern": "^(evidence|inference|abstract-only|abstract only)\\b" },
    "notes": {
      "sensitivity": { "type": "string" },
      "uncertainty": { "type": "string" },
      "debate": { "type": "string" },
      "example": { "type": "boolean" }
    },
    "coords": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "source_format": { "type": "string" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sources", "label"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "label": { "$ref": "#/$defs/label" },
        "nation": { "type": "string" },
        "sensitivity": { "type": "string" },
        "uncertainty": { "type": "string" },
        "debate": { "type": "string" },
        "example": { "type": "boolean" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sources", "label", "name", "status", "approximate_location", "boundary_caveat"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "label": { "$ref": "#/$defs/label" },
        "name": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["present", "historic"] },
        "approximate_location": { "$ref": "#/$defs/coords" },
        "boundary_caveat": { "type": "string" },
        "austlang": { "type": "array", "items": { "type": "string" } },
        "torres_strait": { "type": "boolean" },
        "sensitivity": { "type": "string" },
        "uncertainty": { "type": "string" },
        "debate": { "type": "string" },
        "example": { "type": "boolean" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "nation", "place", "public_summary", "sources", "label", "publish_status", "secret_sacred", "deceased_persons"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "nation": { "type": "string" },
        "place": { "type": "string" },
        "public_summary": { "type": ["string", "null"] },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "label": { "$ref": "#/$defs/label" },
        "publish_status": { "enum": ["link-only", "summary-with-credit", "summary-pending-review"] },
        "secret_sacred": { "type": "boolean" },
        "deceased_persons": { "type": ["boolean", "string"] },
        "deceased_note": { "type": "string" },
        "exclude_from_build": { "type": "boolean" },
        "no_designs": { "type": "boolean" },
        "sensitivity": { "type": "string" },
        "uncertainty": { "type": "string" },
        "debate": { "type": "string" },
        "example": { "type": "boolean" }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sources", "label", "coords"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "label": { "$ref": "#/$defs/label" },
        "coords": { "$ref": "#/$defs/coords" },
        "nation": { "type": "string" },
        "no_stories": { "type": "boolean" },
        "no_photography": { "type": "boolean" },
        "sensitivity": { "type": "string" },
        "uncertainty": { "type": "string" },
        "debate": { "type": "string" },
        "example": { "type": "boolean" }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sources", "label"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "label": { "$ref": "#/$defs/label" },
        "deceased_persons": { "type": ["boolean", "string"] },
        "indigenous": { "type": "boolean" },
        "sensitivity": { "type": "string" },
        "uncertainty": { "type": "string" },
        "debate": { "type": "string" },
        "example": { "type": "boolean" }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sources", "label", "year"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "label": { "$ref": "#/$defs/label" },
        "year": { "type": "number" },
        "sensitivity": { "type": "string" },
        "uncertainty": { "type": "string" },
        "debate": { "type": "string" },
        "example": { "type": "boolean" }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sources", "label"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "label": { "$ref": "#/$defs/label" },
        "sensitivity": { "type": "string" },
        "uncertainty": { "type": "string" },
        "debate": { "type": "string" },
        "example": { "type": "boolean" }
      }
    }
  }
}
